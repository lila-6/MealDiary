<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.diet.mapper.DietRecordMapper">
    
    <resultMap type="DietRecord" id="DietRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="mealType"    column="meal_type"    />
        <result property="foodName"    column="food_name"    />
        <result property="imagePath"    column="image_path"    />
        <result property="audioPath"    column="audio_path"    />
        <result property="note"    column="note"    />
        <result property="createTime"    column="create_time"    />
        <result property="syncStatus"    column="sync_status"    />
    </resultMap>

    <sql id="selectDietRecordVo">
        select id, user_id, meal_type, food_name, image_path, audio_path, note, create_time, sync_status from diet_record
    </sql>

    <select id="selectDietRecordList" parameterType="DietRecord" resultMap="DietRecordResult">
        <include refid="selectDietRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="mealType != null  and mealType != ''"> and meal_type = #{mealType}</if>
            <if test="foodName != null  and foodName != ''"> and food_name like concat('%', #{foodName}, '%')</if>
            <if test="imagePath != null  and imagePath != ''"> and image_path = #{imagePath}</if>
            <if test="audioPath != null  and audioPath != ''"> and audio_path = #{audioPath}</if>
            <if test="note != null  and note != ''"> and note = #{note}</if>
            <if test="syncStatus != null "> and sync_status = #{syncStatus}</if>
        </where>
    </select>
    
    <select id="selectDietRecordById" parameterType="Long" resultMap="DietRecordResult">
        <include refid="selectDietRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertDietRecord" parameterType="DietRecord" useGeneratedKeys="true" keyProperty="id">
        insert into diet_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="mealType != null">meal_type,</if>
            <if test="foodName != null">food_name,</if>
            <if test="imagePath != null">image_path,</if>
            <if test="audioPath != null">audio_path,</if>
            <if test="note != null">note,</if>
            <if test="createTime != null">create_time,</if>
            <if test="syncStatus != null">sync_status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="mealType != null">#{mealType},</if>
            <if test="foodName != null">#{foodName},</if>
            <if test="imagePath != null">#{imagePath},</if>
            <if test="audioPath != null">#{audioPath},</if>
            <if test="note != null">#{note},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="syncStatus != null">#{syncStatus},</if>
         </trim>
    </insert>

    <update id="updateDietRecord" parameterType="DietRecord">
        update diet_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="mealType != null">meal_type = #{mealType},</if>
            <if test="foodName != null">food_name = #{foodName},</if>
            <if test="imagePath != null">image_path = #{imagePath},</if>
            <if test="audioPath != null">audio_path = #{audioPath},</if>
            <if test="note != null">note = #{note},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="syncStatus != null">sync_status = #{syncStatus},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDietRecordById" parameterType="Long">
        delete from diet_record where id = #{id}
    </delete>

    <delete id="deleteDietRecordByIds" parameterType="String">
        delete from diet_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>